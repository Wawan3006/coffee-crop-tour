# Copy this file to .env and fill in real values. NEVER commit the real .env file.
# .env is already listed in .gitignore.

# PostgreSQL connection string.
# Local/dev fallback (no Postgres needed) if you leave this UNSET: sqlite:///./coffee_crop_tour_dev.db
# Production example (managed Postgres, e.g. Railway/Render/Azure/RDS):
# DATABASE_URL=postgresql+psycopg2://ccttour_user:CHANGE_ME@db-host.example.com:5432/coffee_crop_tour
DATABASE_URL=

# Secret used to sign JWT access tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Object/file storage for photos (Step 23). Leave blank to store photo files
# on local disk under backend/photo_storage/ (fine for dev, NOT for production).
# For production, point this at S3 / Azure Blob / GCS and update sync.py's
# save_photo() to upload there instead of local disk.
PHOTO_STORAGE_DIR=./photo_storage

# CORS: comma-separated list of allowed origins (your GitHub Pages URL, etc.)
CORS_ALLOWED_ORIGINS=https://wawan3006.github.io,http://localhost:5500
